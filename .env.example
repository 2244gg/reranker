# Copy this file to `.env` and fill in real keys. NEVER commit `.env`.

# --- OpenAI / OpenAI-compatible (e.g. laozhang.ai proxy) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Use https://api.openai.com/v1 for official, or proxy URL otherwise.
OPENAI_BASE_URL=https://api.laozhang.ai/v1

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Default https://api.anthropic.com . Override only for proxies.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- SiliconFlow / Together (OpenAI-compatible, for open-source models) ---
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
